# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# "desarrollo" o "produccion". En produccion la app se niega a arrancar
# sin una SECRET_KEY propia y cierra la documentación pública.
ENTORNO="desarrollo"

APP_NAME="Restaurante API"
DATABASE_URL="sqlite:///./restaurante.db"

# Genera la tuya con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

ACCESS_TOKEN_EXPIRE_MINUTES=480
IVA=0.16

# Orígenes del navegador autorizados a llamar a la API.
# Nunca uses "*" junto con credenciales.
# CORS_ORIGINS=["http://localhost:5173"]

# Intentos de login permitidos por ventana
LOGIN_INTENTOS=8
LOGIN_VENTANA_SEGUNDOS=300

# Cierra /docs y /redoc
DOCS_PUBLICAS=true
